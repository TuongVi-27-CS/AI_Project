# LLM Provider Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# BGE-M3: provider not selected.
# Example: https://provider.example/v1/embeddings
BGE_M3_API_URL=
BGE_M3_API_KEY=
BGE_M3_MODEL=BAAI/bge-m3
BGE_M3_REVISION=unspecified
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT=60
EMBEDDING_MAX_RETRIES=3

# Character guard
EMBEDDING_MAX_INPUT_CHARS=16000
CHUNK_TARGET_WORDS=500

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Local Data Paths
CHROMA_PERSIST_DIRECTORY=./DATA/chromadb_store
CHROMA_COLLECTION=vector_bge_m3
RAW_DATA_PATH=./DATA/raw
PROCESSED_DATA_PATH=./DATA/processed
TEST_DATASET_PATH=./DATA/test_datasets
VECTOR_OUTPUT_PATH=./DATA/vector_artifacts
EMBEDDING_CACHE_PATH=./DATA/vector_artifacts/embeddings.sqlite3
